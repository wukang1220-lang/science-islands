{
 "s1-1-1": {
  "b": "pond",
  "sign": "生命觀察館",
  "npc": {
   "n": "小蘆",
   "r": "館主",
   "body": "#5a8f3c",
   "hat": "explorer"
  },
  "say": [
   "歡迎來到生命觀察館！池裡的魚在游、青蛙在跳，牠們都是生物。",
   "生物會代謝、生長、感應、生殖，也能維持體內恆定；鐘乳石會變大，卻沒有這些生命現象。",
   "地球上有生物的地方叫生物圈，包括大氣圈下層、整個水圈和岩石圈表層。"
  ]
 },
 "s1-2-1": {
  "b": "scope",
  "sign": "細胞發現館",
  "npc": {
   "n": "鏡叔",
   "r": "館主",
   "body": "#4a5a6a",
   "hat": "cap"
  },
  "say": [
   "1665 年，虎克在軟木片上看到一格一格的小房間，就叫它們細胞。",
   "後來許來登和許旺發現，植物和動物都是由細胞組成的，這是細胞學說的起點。",
   "細胞長什麼樣子和它的工作有關：神經細胞有長突起，紅血球像中間凹下的圓盤。"
  ]
 },
 "s1-2-2": {
  "b": "lab",
  "sign": "胞器展示館",
  "npc": {
   "n": "小粒",
   "r": "館主",
   "body": "#9b6bd1",
   "hat": "goggles"
  },
  "say": [
   "植物細胞有細胞壁、葉綠體和大液泡，動物細胞沒有這些。",
   "細胞膜管進出、細胞核當司令、粒線體負責釋放能量。",
   "觀察洋蔥表皮時滴碘液，細胞核就會被染色，看得更清楚。"
  ]
 },
 "s1-2-3": {
  "b": "beaker",
  "sign": "擴散展示館",
  "npc": {
   "n": "阿滲",
   "r": "館主",
   "body": "#3fb5a8",
   "hat": "none"
  },
  "say": [
   "看我把色素滴進水裡——它會從濃的地方慢慢散到淡的地方，這就是擴散。",
   "水分子通過細胞膜的擴散叫滲透。紅血球泡在清水裡會脹大，泡在濃鹽水裡會皺縮。",
   "植物細胞在濃鹽水中會質壁分離；醃小黃瓜會出水，也是同樣的道理。"
  ]
 },
 "s1-2-4": {
  "b": "blocks",
  "sign": "層次積木館",
  "npc": {
   "n": "層層",
   "r": "館主",
   "body": "#f2c94c",
   "hat": "cap"
  },
  "say": [
   "生物就像積木塔：細胞疊成組織，組織疊成器官。",
   "動物再把器官組成器官系統，最後成為個體；植物少了器官系統這一層。",
   "草履蟲只有一個細胞，卻能吃東西、游泳、生寶寶，是單細胞生物。"
  ]
 },
 "s1-3-1": {
  "b": "market",
  "sign": "養分市集館",
  "npc": {
   "n": "阿豐",
   "r": "館主",
   "body": "#e2774a",
   "hat": "chef"
  },
  "say": [
   "歡迎來到養分市集館！這裡展示的不是零食，是六大類養分。",
   "醣類、蛋白質和脂質能給你能量；水、維生素和礦物質不能產生能量，身體卻少不了它們。",
   "想知道食物裡有沒有澱粉或葡萄糖？滴碘液、或加本氏液隔水加熱，看顏色就知道。"
  ]
 },
 "s1-3-2": {
  "b": "lab",
  "sign": "酵素研究館",
  "npc": {
   "n": "小梅",
   "r": "館主",
   "body": "#f4f1ea",
   "hat": "goggles"
  },
  "say": [
   "噓——我正在看酵素工作。它們是讓反應變快的小幫手，大部分是蛋白質做的。",
   "每種酵素只認得自己的受質，這叫專一性；反應完它還能重複使用。",
   "溫度太高酵素會變性，再也恢復不了；太冷只是變慢。人體的酵素最喜歡約 37 °C。"
  ]
 },
 "s1-3-3": {
  "b": "greenhouse",
  "sign": "光合溫室館",
  "npc": {
   "n": "綠綠",
   "r": "館主",
   "body": "#5a8f3c",
   "hat": "straw"
  },
  "say": [
   "看見溫室裡的葉子了嗎？它們正在用光做飯！",
   "水從根吸上來，二氧化碳從氣孔進來，葉綠體裡的葉綠素吸收光能，做出葡萄糖和氧氣。",
   "想證明光很重要？用鋁箔遮住半片葉子，照光後脫色再滴碘液，就知道哪一邊有澱粉。"
  ]
 },
 "s1-3-4": {
  "b": "train",
  "sign": "消化列車館",
  "npc": {
   "n": "阿腸",
   "r": "館主",
   "body": "#2f6fb5",
   "hat": "cap"
  },
  "say": [
   "嗶嗶！消化列車館要出發了，請抓穩扶手！",
   "口腔的唾液先分解澱粉，胃液接手蛋白質；到了小腸，膽汁、胰液和腸液一起上工。",
   "小腸的絨毛把養分吸收進身體，大腸再把水分收回來。終點站到了，請下車！"
  ]
 },
 "s1-4-1": {
  "b": "tree",
  "sign": "年輪館",
  "npc": {
   "n": "老樟",
   "r": "館主",
   "body": "#8a5a3c",
   "hat": "explorer"
  },
  "say": [
   "樹幹裡的維管束分兩隊：木質部往上送水，韌皮部把養分送到各處。",
   "雙子葉植物的形成層會分裂，讓樹幹一年比一年粗。",
   "春夏長得快、顏色淺，秋冬長得慢、顏色深，一深一淺就是一圈年輪。"
  ]
 },
 "s1-4-2": {
  "b": "garden",
  "sign": "蒸散花園館",
  "npc": {
   "n": "露露",
   "r": "館主",
   "body": "#ef8fb0",
   "hat": "straw"
  },
  "say": [
   "根毛負責喝水，水分經木質部一路爬到葉子。",
   "葉子的氣孔把水蒸氣放出去，這是蒸散作用，也是把水往上拉的力量。",
   "大太陽、有風又乾燥時蒸散最旺盛；移植前剪掉一些葉子，能避免植物缺水。"
  ]
 },
 "s1-4-3": {
  "b": "heart",
  "sign": "心臟館",
  "npc": {
   "n": "心心",
   "r": "館主",
   "body": "#f4f1ea",
   "hat": "cap"
  },
  "say": [
   "聽，撲通撲通——那是心臟瓣膜關起來的聲音。",
   "心臟有兩個心房、兩個心室，左心室要把血送到全身，所以肌肉壁最厚。",
   "動脈把血帶離心臟，靜脈把血帶回來，微血管負責和細胞交換物質。"
  ]
 },
 "s1-4-4": {
  "b": "train",
  "sign": "血液循環館",
  "npc": {
   "n": "阿環",
   "r": "館主",
   "body": "#c2453a",
   "hat": "cap"
  },
  "say": [
   "血液循環館有兩條路線：體循環從左心室出發，跑遍全身再回到右心房。",
   "肺循環從右心室出發，到肺部裝滿氧氣，再回到左心房。",
   "組織液流進淋巴管就變成淋巴，淋巴結裡的白血球會幫忙抓病原體。"
  ]
 },
 "s1-5-1": {
  "b": "eye",
  "sign": "感官體驗館",
  "npc": {
   "n": "敏敏",
   "r": "館主",
   "body": "#2f6fb5",
   "hat": "none"
  },
  "say": [
   "眼睛收光、耳朵收聲音、鼻子和舌頭收化學物質，它們都是受器。",
   "收到刺激後，由肌肉或腺體這些動器做出反應。",
   "在花店待久了就聞不太到香味，這叫感覺疲勞。"
  ]
 },
 "s1-5-2": {
  "b": "brain",
  "sign": "神經傳訊館",
  "npc": {
   "n": "阿突",
   "r": "館主",
   "body": "#5a6f8a",
   "hat": "cap"
  },
  "say": [
   "訊息從受器出發，經感覺神經送到大腦，再由運動神經傳到肌肉。",
   "大腦負責思考，小腦管平衡，腦幹控制心跳和呼吸。",
   "手碰到燙的東西會立刻縮回，那是反射，脊髓就能處理，不必等大腦。"
  ]
 },
 "s1-5-3": {
  "b": "lab",
  "sign": "激素調配館",
  "npc": {
   "n": "腺姐",
   "r": "館主",
   "body": "#e2774a",
   "hat": "goggles"
  },
  "say": [
   "內分泌腺把激素直接放進血液，送到全身作用。",
   "腦垂腺管生長，甲狀腺管代謝，胰島分泌胰島素和升糖素調節血糖。",
   "緊張時腎上腺素讓心跳加快；青春期的變化則和性激素有關。"
  ]
 },
 "s1-5-4": {
  "b": "garden",
  "sign": "向光花園館",
  "npc": {
   "n": "葵葵",
   "r": "館主",
   "body": "#f2c94c",
   "hat": "straw"
  },
  "say": [
   "你看那盞燈！花園裡的莖都朝它彎過去，這是向光性。",
   "根往下長是向地性，往水多的地方長是向水性，都和植物激素有關。",
   "動物的行為有天生就會的本能行為，也有靠經驗學會的學習行為。"
  ]
 },
 "s1-6-1": {
  "b": "breath",
  "sign": "呼吸館",
  "npc": {
   "n": "阿肺",
   "r": "館主",
   "body": "#3fb5a8",
   "hat": "cap"
  },
  "say": [
   "拉下瓶底的橡皮膜，瓶裡的氣球就鼓起來——這就是吸氣時橫膈下降的樣子。",
   "肺泡外包著微血管，氧氣擴散進血液，二氧化碳擴散出來。",
   "運動時二氧化碳變多，腦幹會讓你呼吸又深又快。"
  ]
 },
 "s1-6-2": {
  "b": "beaker",
  "sign": "腎臟過濾館",
  "npc": {
   "n": "濾濾",
   "r": "館主",
   "body": "#2f6fb5",
   "hat": "goggles"
  },
  "say": [
   "肝臟把有毒的氨變成尿素，腎臟再把尿素和多餘的水過濾出來。",
   "尿液經輸尿管到膀胱儲存，再由尿道排出。",
   "流很多汗的日子尿量會變少，這是身體在維持水分恆定。"
  ]
 },
 "s1-6-3": {
  "b": "lab",
  "sign": "恆溫控制館",
  "npc": {
   "n": "溫溫",
   "r": "館主",
   "body": "#c2453a",
   "hat": "cap"
  },
  "say": [
   "天熱時皮膚微血管擴張、流汗散熱；天冷時微血管收縮、肌肉發抖產熱。",
   "鳥類和哺乳類是內溫動物，體溫大致穩定；蛇和青蛙是外溫動物。",
   "飯後血糖升高，胰島素讓它降下來；肚子餓時，升糖素讓肝糖變回葡萄糖。"
  ]
 },
 "s2-1-1": {
  "b": "scope",
  "sign": "細胞分裂館",
  "npc": {
   "n": "分分",
   "r": "館主",
   "body": "#9b6bd1",
   "hat": "goggles"
  },
  "say": [
   "細胞分裂前，染色體會先複製一次，再平分給兩個子細胞。",
   "製造精子和卵要用減數分裂：連續分裂兩次，染色體數目減半。",
   "精子和卵結合成受精卵，染色體數目又回到和體細胞一樣。"
  ]
 },
 "s2-1-2": {
  "b": "garden",
  "sign": "扦插苗圃館",
  "npc": {
   "n": "阿苗",
   "r": "館主",
   "body": "#5aa83c",
   "hat": "straw"
  },
  "say": [
   "剪一段枝條插進土裡就能長成新植株，這叫扦插，是無性生殖。",
   "馬鈴薯用塊莖、甘薯用塊根、草莓用匍匐莖，都能長出新植株。",
   "無性生殖的子代和親代幾乎一樣；想保留好吃的品種，可以用嫁接。"
  ]
 },
 "s2-1-3": {
  "b": "pond",
  "sign": "孵育館",
  "npc": {
   "n": "蛙媽",
   "r": "館主",
   "body": "#6dbb4a",
   "hat": "flower"
  },
  "say": [
   "青蛙在水中體外受精，一次產下很多卵；鳥類和哺乳類則是體內受精。",
   "花粉落到柱頭上叫授粉，受精後子房長成果實，胚珠長成種子。",
   "有性生殖的子代混合了爸媽的基因，變異多，比較能適應環境的改變。"
  ]
 },
 "s2-2-1": {
  "b": "helix",
  "sign": "基因館",
  "npc": {
   "n": "孟孟",
   "r": "館主",
   "body": "#2f6fb5",
   "hat": "cap"
  },
  "say": [
   "基因在染色體上，成對存在，一個來自爸爸、一個來自媽媽。",
   "顯性基因用大寫字母、隱性基因用小寫字母，Aa 會表現出顯性性狀。",
   "Aa 和 Aa 交配，子代顯性和隱性的比例大約是 3：1，用棋盤方格法就能算出來。"
  ]
 },
 "s2-2-2": {
  "b": "blocks",
  "sign": "家譜積木館",
  "npc": {
   "n": "譜譜",
   "r": "館主",
   "body": "#e2774a",
   "hat": "none"
  },
  "say": [
   "女生是 XX，男生是 XY；精子帶 X 還是 Y，決定寶寶的性別。",
   "ABO 血型由 Iᴬ、Iᴮ、i 三種基因決定，O 型的人是 ii。",
   "A 型和 B 型的爸媽，有可能生出 A、B、AB、O 四種血型的孩子。"
  ]
 },
 "s2-2-3": {
  "b": "scope",
  "sign": "突變觀測館",
  "npc": {
   "n": "小變",
   "r": "館主",
   "body": "#5a6f8a",
   "hat": "goggles"
  },
  "say": [
   "基因或染色體改變叫突變，紫外線、X 射線和某些化學物質都可能誘發。",
   "生殖細胞的突變可能遺傳給子代，例如白化症是隱性遺傳疾病。",
   "唐氏症是第 21 對染色體多了一條；遺傳諮詢可以幫忙了解風險。"
  ]
 },
 "s2-2-4": {
  "b": "lab",
  "sign": "生技研究館",
  "npc": {
   "n": "轉轉",
   "r": "館主",
   "body": "#3fb5a8",
   "hat": "goggles"
  },
  "say": [
   "把人類的胰島素基因放進細菌，細菌就能幫忙生產胰島素，這是基因轉殖。",
   "桃莉羊是用成年羊的細胞核複製出來的，牠和提供細胞核的羊遺傳特徵相同。",
   "生物技術很有用，但也要注意基因擴散和食品安全等問題。"
  ]
 },
 "s2-3-1": {
  "b": "fossil",
  "sign": "化石博物館",
  "npc": {
   "n": "岩伯",
   "r": "館主",
   "body": "#8a5a3c",
   "hat": "explorer"
  },
  "say": [
   "化石多半藏在沉積岩裡；沒有被翻動過的地層，愈下面愈古老。",
   "始祖鳥有羽毛也有牙齒，說明鳥類可能由爬蟲類演化而來。",
   "達爾文的天擇說：適應環境的個體比較能活下來，把有利的變異傳給下一代。"
  ]
 },
 "s2-3-2": {
  "b": "blocks",
  "sign": "分類標本館",
  "npc": {
   "n": "林林",
   "r": "館主",
   "body": "#6a8f5a",
   "hat": "cap"
  },
  "say": [
   "分類從大到小是界、門、綱、目、科、屬、種，種是基本單位。",
   "學名用二名法：屬名加種小名，屬名開頭大寫。",
   "馬和驢生下的騾不能生殖，所以馬和驢是不同的種。"
  ]
 },
 "s2-3-3": {
  "b": "beaker",
  "sign": "微生物培養館",
  "npc": {
   "n": "菌菌",
   "r": "館主",
   "body": "#fffaf3",
   "hat": "beanie"
  },
  "say": [
   "細菌沒有核膜包住的細胞核，屬於原核生物；藍菌還能行光合作用。",
   "草履蟲、眼蟲和藻類有細胞核，屬於原生生物界。",
   "香菇、黴菌、酵母菌是真菌，用孢子繁殖，也是重要的分解者。"
  ]
 },
 "s2-3-4": {
  "b": "greenhouse",
  "sign": "植物溫室館",
  "npc": {
   "n": "蕨叔",
   "r": "館主",
   "body": "#4f7f2a",
   "hat": "straw"
  },
  "say": [
   "蘚苔沒有維管束，只能長得矮矮的，住在潮溼的地方。",
   "蕨類有維管束但不結種子，葉背的孢子囊群就是它繁殖的祕密。",
   "松樹是裸子植物，種子外沒有果實；會開花結果的是被子植物。"
  ]
 },
 "s2-3-5": {
  "b": "pond",
  "sign": "動物觀察館",
  "npc": {
   "n": "阿生",
   "r": "館主",
   "body": "#2f6fb5",
   "hat": "explorer"
  },
  "say": [
   "昆蟲有三對腳，蜘蛛有四對腳，牠們都是節肢動物。",
   "池裡的青蛙小時候用鰓呼吸，長大後用肺和皮膚呼吸，是兩生類。",
   "鯨魚和蝙蝠都用乳汁餵寶寶，牠們是哺乳類。"
  ]
 },
 "s2-4-1": {
  "b": "tree",
  "sign": "森林調查館",
  "npc": {
   "n": "數數",
   "r": "館主",
   "body": "#6a8f5a",
   "hat": "explorer"
  },
  "say": [
   "同一區域裡同一種生物的所有個體叫族群，所有族群合起來叫群集。",
   "調查田鼠可以用捉放法：先標記、放回，再捉一次來估算總數。",
   "森林火災後，草、灌木、大樹會依序長回來，這叫演替。"
  ]
 },
 "s2-4-2": {
  "b": "garden",
  "sign": "共生花園館",
  "npc": {
   "n": "蜂蜂",
   "r": "館主",
   "body": "#f2c94c",
   "hat": "beanie"
  },
  "say": [
   "蜜蜂採花蜜也幫花傳粉，雙方都得到好處，這是互利共生。",
   "跳蚤吸狗的血是寄生；獅子吃斑馬是掠食；稗草和水稻搶陽光是競爭。",
   "用瓢蟲吃蚜蟲、用寄生蜂對付害蟲，叫生物防治，可以少用農藥。"
  ]
 },
 "s2-4-3": {
  "b": "blocks",
  "sign": "能量金字塔館",
  "npc": {
   "n": "能能",
   "r": "館主",
   "body": "#e2774a",
   "hat": "cap"
  },
  "say": [
   "生產者把太陽能變成養分，消費者吃它們，分解者把遺體分解回環境。",
   "能量往上傳時大部分變成熱散失，所以能量金字塔館下寬上窄。",
   "能量單向流動，碳、氮、水這些物質卻能在生物和環境之間循環。"
  ]
 },
 "s2-4-4": {
  "b": "pond",
  "sign": "溼地生態館",
  "npc": {
   "n": "筆筆",
   "r": "館主",
   "body": "#3fb5a8",
   "hat": "straw"
  },
  "say": [
   "河口是河水和海水交會的地方，鹽度忽高忽低，生物得很能適應。",
   "水筆仔的種子在樹上就發芽，掉下來時直接插進泥裡生長。",
   "海洋是面積最大的生態系，浮游藻類是海裡最重要的生產者。"
  ]
 },
 "s2-5-1": {
  "b": "garden",
  "sign": "多樣性花園館",
  "npc": {
   "n": "多多",
   "r": "館主",
   "body": "#9b6bd1",
   "hat": "flower"
  },
  "say": [
   "生物多樣性有三層：遺傳多樣性、物種多樣性和生態系多樣性。",
   "物種愈多、食物網愈複雜，生態系通常愈穩定。",
   "臺灣地形多變、海拔落差大，所以有很多特有種，像臺灣獼猴、臺灣藍鵲。"
  ]
 },
 "s2-5-2": {
  "b": "beaker",
  "sign": "汙染檢測館",
  "npc": {
   "n": "檢檢",
   "r": "館主",
   "body": "#5a6f8a",
   "hat": "goggles"
  },
  "say": [
   "難分解的汙染物會沿食物鏈愈積愈多，最上層的動物體內濃度最高。",
   "福壽螺、小花蔓澤蘭是外來入侵種，在臺灣缺少天敵，到處擴散。",
   "棲地破壞、過度捕撈和全球暖化，都讓生物多樣性面臨危機。"
  ]
 },
 "s2-5-3": {
  "b": "tree",
  "sign": "保育森林館",
  "npc": {
   "n": "阿護",
   "r": "館主",
   "body": "#4f7f2a",
   "hat": "explorer"
  },
  "say": [
   "國家公園是就地保育；動物園、植物園和種子庫是移地保育。",
   "華盛頓公約管制瀕危動植物的買賣，拉姆薩公約保護溼地。",
   "不買保育類製品、不隨意放生，你也能成為保育的一份子。"
  ]
 },
 "s3-2-1": {
  "b": "beaker",
  "sign": "物質探索館",
  "npc": {
   "n": "阿氧",
   "r": "館主",
   "body": "#3fb5a8",
   "hat": "goggles"
  },
  "say": [
   "物質占有空間、具有質量；光和熱是能量，不算物質。",
   "冰融化是物理變化，紙燃燒產生新物質，是化學變化。",
   "線香放進氧氣燒得更旺，二氧化碳則會讓石灰水變混濁。"
  ]
 },
 "s3-2-2": {
  "b": "lab",
  "sign": "溶液調配館",
  "npc": {
   "n": "小濃",
   "r": "館主",
   "body": "#ef8fb0",
   "hat": "goggles"
  },
  "say": [
   "溶液＝溶質＋溶劑；只要有水，通常把水當溶劑。",
   "重量百分濃度＝溶質質量 ÷ 溶液質量 × 100%，別忘了溶液要加上溶質。",
   "汽水放溫暖的地方會冒泡，因為氣體的溶解度隨溫度升高而變小。"
  ]
 },
 "s3-2-3": {
  "b": "still",
  "sign": "分離工作館",
  "npc": {
   "n": "阿濾",
   "r": "館主",
   "body": "#5a6f8a",
   "hat": "cap"
  },
  "say": [
   "沙子和食鹽水用過濾分開，海水要得到淡水就用蒸餾。",
   "蒸餾時溫度計放在支管口附近，還要加沸石防止突沸。",
   "黑色墨水在濾紙上分出好幾種顏色，這就是色層分析。"
  ]
 },
 "s3-6-1": {
  "b": "lab",
  "sign": "元素研究館",
  "npc": {
   "n": "阿素",
   "r": "館主",
   "body": "#9b6bd1",
   "hat": "goggles"
  },
  "say": [
   "水通電分解成氫氣和氧氣，所以水是化合物，氫和氧是元素。",
   "金屬有光澤、能導電；非金屬大多不導電，但石墨例外。",
   "看部首就知道狀態：金字旁是金屬，「气」是氣體，「水」是液體。"
  ]
 },
 "s3-6-2": {
  "b": "crystal",
  "sign": "元素寶庫館",
  "npc": {
   "n": "金叔",
   "r": "館主",
   "body": "#c9a86a",
   "hat": "cap"
  },
  "say": [
   "銀的導電性最好，銅第二，所以電線多用銅。",
   "鋁很活潑，表面的氧化鋁卻像盔甲一樣保護裡面。",
   "碳有石墨、鑽石、巴克球好幾種樣子，它們是同素異形體。"
  ]
 },
 "s3-6-3": {
  "b": "atom",
  "sign": "原子模型館",
  "npc": {
   "n": "湯湯",
   "r": "館主",
   "body": "#2f6fb5",
   "hat": "explorer"
  },
  "say": [
   "原子中心是原子核，裡面有質子和中子，電子在外面快速移動。",
   "質子數就是原子序，決定這是哪一種元素。",
   "質子數相同、中子數不同的原子，互稱同位素。"
  ]
 },
 "s3-6-4": {
  "b": "periodic",
  "sign": "週期表館",
  "npc": {
   "n": "列列",
   "r": "館主",
   "body": "#e2774a",
   "hat": "cap"
  },
  "say": [
   "現在的週期表依原子序排列：橫的叫週期，直的叫族。",
   "同一族的元素化學性質相似，例如鹼金屬都會和水劇烈反應。",
   "最右邊的第 18 族是鈍氣，很難和其他物質反應。"
  ]
 },
 "s3-6-5": {
  "b": "molecule",
  "sign": "分子積木館",
  "npc": {
   "n": "小分",
   "r": "館主",
   "body": "#5aa83c",
   "hat": "none"
  },
  "say": [
   "分子是能表現物質性質的最小粒子，由原子組成。",
   "H₂O 表示一個水分子有 2 個氫原子、1 個氧原子。",
   "金屬不是以分子存在，化學式直接寫元素符號，例如 Fe。"
  ]
 },
 "s4-1-1": {
  "b": "balance",
  "sign": "守恆天平館",
  "npc": {
   "n": "秤秤",
   "r": "館主",
   "body": "#6a8f5a",
   "hat": "cap"
  },
  "say": [
   "化學反應只是原子重新排列，原子的種類和數目都不變。",
   "在密閉容器裡反應，反應前後總質量一樣，這就是質量守恆定律。",
   "開放的燒杯產生氣體跑掉了，看起來變輕，其實仍遵守質量守恆。"
  ]
 },
 "s4-1-2": {
  "b": "molecule",
  "sign": "反應式工坊",
  "npc": {
   "n": "式式",
   "r": "館主",
   "body": "#f2c94c",
   "hat": "cap"
  },
  "say": [
   "反應物寫左邊、生成物寫右邊，再加係數讓原子數目平衡。",
   "1 莫耳大約有 6×10²³ 個粒子，這個數叫亞佛加厥數。",
   "1 莫耳水是 18 g，1 莫耳二氧化碳是 44 g。"
  ]
 },
 "s4-2-1": {
  "b": "fire",
  "sign": "燃燒觀察館",
  "npc": {
   "n": "炎炎",
   "r": "館主",
   "body": "#c2453a",
   "hat": "goggles"
  },
  "say": [
   "燃燒是物質和氧劇烈結合的氧化反應，會放出光和熱。",
   "金屬氧化物溶於水呈鹼性，非金屬氧化物溶於水呈酸性。",
   "鎂燃燒最劇烈、銅最慢，所以活性是鎂大於鋅、鋅大於銅。"
  ]
 },
 "s4-2-2": {
  "b": "furnace",
  "sign": "煉鐵高爐館",
  "npc": {
   "n": "阿爐",
   "r": "館主",
   "body": "#4a4a4a",
   "hat": "cap"
  },
  "say": [
   "搶走氧的是還原劑，自己被氧化；交出氧的是氧化劑。",
   "煉鐵時用焦炭產生的一氧化碳，把氧化鐵裡的氧搶走。",
   "氧化和還原一定同時發生，有人得到氧，就有人失去氧。"
  ]
 },
 "s4-3-1": {
  "b": "battery",
  "sign": "導電測試館",
  "npc": {
   "n": "阿電",
   "r": "館主",
   "body": "#5a6f8a",
   "hat": "cap"
  },
  "say": [
   "食鹽水能讓燈泡亮，糖水不行：氯化鈉是電解質，糖不是。",
   "電解質溶於水會解離成陽離子和陰離子。",
   "通電時陽離子跑向負極、陰離子跑向正極，溶液就導電了。"
  ]
 },
 "s4-3-2": {
  "b": "lab",
  "sign": "酸鹼實驗館",
  "npc": {
   "n": "酸酸",
   "r": "館主",
   "body": "#f2c94c",
   "hat": "goggles"
  },
  "say": [
   "酸溶於水會產生 H⁺，鹼溶於水會產生 OH⁻。",
   "稀酸遇到鎂帶產生氫氣，遇到大理石產生二氧化碳。",
   "稀釋濃硫酸要把酸慢慢倒進水裡，千萬不能反過來。"
  ]
 },
 "s4-3-3": {
  "b": "ph",
  "sign": "pH 彩虹館",
  "npc": {
   "n": "虹虹",
   "r": "館主",
   "body": "#9b6bd1",
   "hat": "none"
  },
  "say": [
   "pH 小於 7 是酸性，等於 7 是中性，大於 7 是鹼性。",
   "pH 值每差 1，氫離子濃度就差 10 倍。",
   "酚酞遇到鹼性溶液會變紅，在酸性和中性中是無色的。"
  ]
 },
 "s4-3-4": {
  "b": "beaker",
  "sign": "中和滴定館",
  "npc": {
   "n": "和和",
   "r": "館主",
   "body": "#3fb5a8",
   "hat": "goggles"
  },
  "say": [
   "酸和鹼反應生成鹽和水，H⁺ 和 OH⁻ 結合成水。",
   "酚酞剛變淡紅色的時候，就是剛好中和。",
   "小蘇打、蘇打、石膏、大理石，都是生活中常見的鹽類。"
  ]
 },
 "s4-4-1": {
  "b": "beaker",
  "sign": "速率實驗館",
  "npc": {
   "n": "快快",
   "r": "館主",
   "body": "#e2774a",
   "hat": "goggles"
  },
  "say": [
   "粒子要互相碰撞才會反應，碰撞愈多，反應愈快。",
   "粉末、高濃度、高溫都能讓反應變快。",
   "催化劑能加快反應，自己卻不會被用掉，產量也不變。"
  ]
 },
 "s4-4-2": {
  "b": "seesaw",
  "sign": "動態平衡館",
  "npc": {
   "n": "衡衡",
   "r": "館主",
   "body": "#3fb5a8",
   "hat": "none"
  },
  "say": [
   "看，兩邊的粒子一直跑來跑去，但兩邊的數量保持不變，這就是動態平衡。",
   "平衡時正反應和逆反應的速率相等，反應並沒有停止。",
   "加熱 N₂O₄ 和 NO₂ 的混合氣體，紅棕色會變深，平衡往吸熱的方向移動。"
  ]
 },
 "s4-5-1": {
  "b": "fire",
  "sign": "有機燃燒館",
  "npc": {
   "n": "阿碳",
   "r": "館主",
   "body": "#6a8f5a",
   "hat": "explorer"
  },
  "say": [
   "有機化合物都含有碳，加熱常會變黑、燃燒產生二氧化碳。",
   "烏勒在實驗室合成出尿素，證明有機物不一定要由生物製造。",
   "二氧化碳和碳酸鈣雖然含碳，卻屬於無機化合物。"
  ]
 },
 "s4-5-2": {
  "b": "still",
  "sign": "油氣加工館",
  "npc": {
   "n": "烴烴",
   "r": "館主",
   "body": "#4a4a4a",
   "hat": "cap"
  },
  "say": [
   "只含碳和氫的化合物叫做烴，天然氣的主要成分是甲烷。",
   "酒精就是乙醇，75% 的酒精可以消毒；甲醇有毒，千萬不能喝。",
   "醇和有機酸在濃硫酸幫忙下，會生成有香味的酯。"
  ]
 },
 "s4-5-3": {
  "b": "loom",
  "sign": "纖維紡織館",
  "npc": {
   "n": "紡紡",
   "r": "館主",
   "body": "#ef8fb0",
   "hat": "beanie"
  },
  "say": [
   "棉、麻燒起來有燒紙味，羊毛、蠶絲有燒羽毛的臭味。",
   "尼龍是用石油做的合成纖維，燒起來會熔成硬球。",
   "受熱會軟化的塑膠可以回收重塑，電木這類熱固性塑膠就不行。"
  ]
 },
 "s4-5-4": {
  "b": "soap",
  "sign": "肥皂工坊館",
  "npc": {
   "n": "泡泡",
   "r": "館主",
   "body": "#7fc28f",
   "hat": "beanie"
  },
  "say": [
   "油脂加鹼一起煮，就會產生肥皂和甘油，這叫皂化。",
   "肥皂一端抓油、一端愛水，油汙就被水帶走了。",
   "硬水會讓肥皂沉澱，這時候合成清潔劑比較好用。"
  ]
 },
 "s6-1-3": {
  "b": "battery",
  "sign": "電池研究館",
  "npc": {
   "n": "鋅鋅",
   "r": "館主",
   "body": "#2f6fb5",
   "hat": "goggles"
  },
  "say": [
   "鋅比銅活潑，鋅失去電子當負極，電子經導線流到銅片。",
   "鹽橋讓電路連通，拿走鹽橋，電流就停了。",
   "鉛蓄電池、鋰電池可以充電，是二次電池。"
  ]
 },
 "s6-1-4": {
  "b": "lab",
  "sign": "電鍍工坊館",
  "npc": {
   "n": "鍍鍍",
   "r": "館主",
   "body": "#c9a86a",
   "hat": "goggles"
  },
  "say": [
   "電解水時負極產生氫氣、正極產生氧氣，體積比約 2：1。",
   "電鍍時被鍍的東西接負極，要鍍的金屬接正極。",
   "電鍍廢液含有重金屬，一定要妥善處理才不會汙染環境。"
  ]
 },
 "s3-1-1": {
  "b": "pendulum",
  "sign": "計時鐘擺館",
  "npc": {
   "n": "擺擺",
   "r": "館主",
   "body": "#2f6fb5",
   "hat": "cap"
  },
  "say": [
   "現在「秒」的標準是用銫原子定義的，比任何鐘擺都準。",
   "擺幅不大時，單擺來回一次的時間幾乎固定。",
   "擺長愈長擺一次愈久；換重一點的擺錘倒是沒差。"
  ]
 },
 "s3-1-2": {
  "b": "ruler",
  "sign": "刻度測量館",
  "npc": {
   "n": "刻刻",
   "r": "館主",
   "body": "#e0a35a",
   "hat": "none"
  },
  "say": [
   "測量結果要有數字，也要有單位。",
   "數字是準確值再加一位估計值，估到最小刻度的下一位。",
   "多量幾次再取平均，誤差就會變小。"
  ]
 },
 "s3-1-3": {
  "b": "cylinder",
  "sign": "密度量筒館",
  "npc": {
   "n": "阿密",
