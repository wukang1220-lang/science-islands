   "hat": "cap"
  },
  "say": [
   "奧斯特發現：電流會產生磁場。",
   "線圈裡放鐵心再通電，就是電磁鐵。",
   "一斷電，電磁鐵的磁性就消失了。"
  ]
 },
 "s6-2-3": {
  "b": "motor",
  "sign": "馬達館",
  "npc": {
   "n": "馬馬",
   "r": "館主",
   "body": "#3a5f9a",
   "hat": "goggles"
  },
  "say": [
   "通電的線圈在磁場中受力，就會轉動。",
   "用右手開掌定則，判斷導線受力的方向。",
   "換向器讓線圈每轉半圈就換一次電流方向，才能一直轉。"
  ]
 },
 "s6-2-4": {
